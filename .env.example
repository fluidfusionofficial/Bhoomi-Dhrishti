# ─────────────────────────────────────────────────────────────────────────────
# Bhoomi Dhrishti – Environment Variables Reference
# Copy to .env and fill in values before `make up`
# ─────────────────────────────────────────────────────────────────────────────

# ── Project ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=bhoomi-dhrishti
APP_ENV=development          # development | staging | production

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bhoomi
POSTGRES_USER=bhoomi
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_MAX_CONNECTIONS=200

# Async DSN used by all services
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
REDIS_CACHE_TTL_DEFAULT=300   # seconds

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=bhoomi
RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_VHOST=bhoomi
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=bhoomi-dhrishti
KEYCLOAK_CLIENT_ID=service-account
KEYCLOAK_CLIENT_SECRET=change_me_keycloak_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
# JWKS endpoint for JWT verification
KEYCLOAK_JWKS_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}/realms/${KEYCLOAK_REALM}/protocol/openid-connect/token

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Service Ports (internal Docker network) ──────────────────────────────────
PARCEL_IDENTITY_PORT=8001
GEOSPATIAL_PORT=8002
REVENUE_RECORDS_PORT=8003
REGISTRATION_PORT=8004
PLANNING_ZONING_PORT=8005
FISCAL_PORT=8006
UTILITIES_PORT=8007
TRUST_ENGINE_PORT=8008
ML_INFERENCE_PORT=8009
CITIZEN_SERVICES_PORT=8010
AUDIT_PORT=8011
NOTIFICATIONS_PORT=8012
SEARCH_PORT=8013
ANALYTICS_PORT=8014
INTEROPERABILITY_PORT=8015
SATELLITE_PORT=8016

# ── Security ─────────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
SECRET_KEY=change_me_minimum_32_char_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ── Observability ────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text (text for local dev)

# ── ML / Inference ───────────────────────────────────────────────────────────
ML_MODEL_PATH=/app/models
ML_CONFLICT_THRESHOLD_HIGH=0.75
ML_CONFLICT_THRESHOLD_MEDIUM=0.40

# ── Satellite / Remote Sensing ───────────────────────────────────────────────
SATELLITE_API_KEY=your_isro_bhuvan_or_usgs_api_key
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# ── Interoperability ─────────────────────────────────────────────────────────
DILRMP_API_BASE=https://dolr.gov.in/dilrmp/api/v1
DILRMP_API_KEY=your_dilrmp_api_key
NGDRS_API_BASE=https://ngdrs.gov.in/api/v1
NGDRS_API_KEY=your_ngdrs_api_key
SVAMITVA_API_BASE=https://svamitva.nic.in/api/v1

# ── Notifications ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@bhoomidhrishti.gov.in
SMTP_PASSWORD=change_me_smtp_password
SMS_GATEWAY_URL=https://smsgw.gov.in/api/v1
SMS_GATEWAY_KEY=your_sms_gateway_api_key

# ── Search ───────────────────────────────────────────────────────────────────
# Postgres full-text search is primary; optional external search
SEARCH_INDEX_ENABLED=true

# ── Feature Flags ────────────────────────────────────────────────────────────
FEATURE_ML_SCORING=true
FEATURE_SATELLITE_WATCH=true
FEATURE_LIVE_SYNC=false      # Disabled until state APIs available
